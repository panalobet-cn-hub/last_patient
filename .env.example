# Supabase project > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Public deployed site origin, no trailing slash. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protect /qr-generator and its PNG download endpoint.
QR_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional; set true on HTTPS deployment (Vercel). Localhost works without it.
COOKIE_SECURE=false
